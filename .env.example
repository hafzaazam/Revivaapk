# Copy this file to `.env.local` and fill in values from
# Supabase → Project Settings → API

# Project URL (must be https://xxxx.supabase.co)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# anon / public key (safe for the browser — protected by RLS)
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Admin login email (must match the Auth user you create)
VITE_ADMIN_EMAIL=Admin@gmail.com

# Optional: override catalog price locally before DB seed is applied
# VITE_PRODUCT_PRICE_PKR=2499
